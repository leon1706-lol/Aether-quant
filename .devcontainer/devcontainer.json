{
    "name": "Aether Quant",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "features": {
        "ghcr.io/devcontainers/features/sshd:1": {
            "version": "latest"
        }
    },
    "hostRequirements": {
        "cpus": 2,
        "memory": "8gb"
    },
    "postCreateCommand": "pip install --require-hashes -r requirements/lock/ci.txt && pip install --no-deps -e ."
}
